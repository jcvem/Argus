# Argus Control Plane - Firebase Authentication Configuration
# Copy this file to .env.local and replace placeholders with credentials from your Firebase Console.
# When environment variables are omitted or blank, the app runs in unauthenticated demo shell mode.

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional: RedactCore API Service URL (defaults to http://localhost:8000 when running RedactCore locally)
NEXT_PUBLIC_REDACTCORE_API_URL=http://localhost:8000

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for auth & role verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function getMemberData(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data;
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && getMemberData(orgId).roleId == 'role-admin';
    }

    // 1. Top-Level Organization Structure
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if isAuthenticated();
      allow update, delete: if isOrgAdmin(orgId);

      // 2. Roles Collection
      match /roles/{roleId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgAdmin(orgId);
      }

      // 3. Organization Members & Seats
      match /members/{userId} {
        allow read: if isOrgMember(orgId);
        // Only Admin can add or modify members (subject to seat counts)
        allow create, update, delete: if isOrgAdmin(orgId);
      }

      // 4. Invitations (Admin only, seat limit protected)
      match /invitations/{invitationId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgAdmin(orgId);
      }

      // 5. Workspaces (Default: Demo-{Org} & {Org})
      match /workspaces/{workspaceId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgAdmin(orgId);

        // 6. AI Agents (Agent Studio)
        // INVARIANTS:
        // - Agent CANNOT have Admin role (roleId != 'role-admin')
        // - Agent must be owned by the creator (createdByUserId == auth.uid)
        // - User B cannot update/execute User A's agent (Confused Deputy Guard)
        match /agents/{agentId} {
          allow read: if isOrgMember(orgId);
          allow create: if isOrgMember(orgId) &&
            request.resource.data.roleId != 'role-admin' &&
            request.resource.data.createdByUserId == request.auth.uid;
          
          allow update: if isOrgMember(orgId) &&
            request.resource.data.roleId != 'role-admin' &&
            (resource.data.createdByUserId == request.auth.uid || isOrgAdmin(orgId));

          allow delete: if isOrgMember(orgId) &&
            (resource.data.createdByUserId == request.auth.uid || isOrgAdmin(orgId));
        }

        // Documents partition metadata
        match /documents/{docId} {
          allow read: if isOrgMember(orgId);
          allow write: if isOrgMember(orgId);
        }
      }

      // 7. Policies (RedactCore / Aristotle)
      match /policies/{policyId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgAdmin(orgId);
      }

      // 8. Audit Events / Activity Feed (Live agent queries & derived view logs)
      match /audit_events/{eventId} {
        // Allow public read on the demo organization org-hukurou so evaluators/judges can view live streams
        allow read: if orgId == 'org-hukurou' || isOrgMember(orgId);
        allow create: if orgId == 'org-hukurou' || isOrgMember(orgId);
        allow update, delete: if isOrgAdmin(orgId);
      }
    }
  }
}

